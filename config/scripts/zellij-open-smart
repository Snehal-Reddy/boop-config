#!/usr/bin/env python3
"""Smart floating opener for Zellij: opens .md files in leaf and everything else in micro."""

import base64
import glob
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
import urllib.parse

HOME = os.path.expanduser("~")
LEAF_BIN = shutil.which("leaf") or os.path.join(HOME, ".local", "bin", "leaf")
MICRO_BIN = shutil.which("micro") or "/usr/bin/micro"
SCREEN_DUMP_PATH = "/tmp/zellij-active-pane.txt"


def parse_target(raw: str, cwds: list[str] | None = None) -> tuple[str | None, str | None]:
    """Parse a raw link or path string into (resolved_file_path, line_number)."""
    if not raw:
        return None, None
    s = raw.strip().strip("'\"`<>()[]{}")
    if not s:
        return None, None

    line = None

    # Strip file:// scheme
    if s.startswith("file://"):
        s = urllib.parse.unquote(s[len("file://") :])
        if s.startswith("localhost/"):
            s = s[len("localhost") :]

    # Extract #L123 or #L123-L145 suffix
    m_hash = re.search(r"#L(\d+)(?:-L?\d+)?$", s)
    if m_hash:
        line = m_hash.group(1)
        s = s[: m_hash.start()]

    # Extract :123 or :123:45 suffix
    m_colon = re.search(r":(\d+)(?::\d+)?$", s)
    if m_colon:
        if not line:
            line = m_colon.group(1)
        s = s[: m_colon.start()]

    # Expand ~ and env vars
    s = os.path.expanduser(os.path.expandvars(s))

    if os.path.isfile(s):
        return os.path.abspath(s), line

    if cwds and not os.path.isabs(s):
        for cwd in cwds:
            candidate = os.path.join(cwd, s)
            if os.path.isfile(candidate):
                return os.path.abspath(candidate), line

    return None, line


def read_osc52_clipboard(timeout: float = 0.18) -> str:
    """Query host terminal clipboard via OSC 52 (requires dangerously_enable_paste_buffer_read true)."""
    try:
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return ""

    old_attrs = None
    try:
        old_attrs = termios.tcgetattr(fd)
        tty.setraw(fd, termios.TCSANOW)
        os.write(fd, b"\x1b]52;c;?\x07")

        buf = b""
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            remaining = max(0.0, deadline - time.monotonic())
            r, _, _ = select.select([fd], [], [], min(remaining, 0.05))
            if not r:
                if buf:
                    break
                continue
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            buf += chunk
            if b"\x07" in buf or b"\x1b\\" in buf:
                break

        m = re.search(rb"\x1b\]52;[^;]*;([A-Za-z0-9+/=\r\n]+)(?:\x07|\x1b\\)", buf)
        if m:
            b64 = m.group(1).replace(b"\r", b"").replace(b"\n", b"")
            return base64.b64decode(b64).decode("utf-8", errors="replace").strip()
    except Exception:
        pass
    finally:
        if old_attrs is not None:
            try:
                termios.tcsetattr(fd, termios.TCSANOW, old_attrs)
            except Exception:
                pass
        try:
            os.close(fd)
        except OSError:
            pass
    return ""


def get_micro_processes() -> list[tuple[str, list[str]]]:
    """Return [(cwd, args), ...] for running micro processes owned by current user."""
    results = []
    uid = os.getuid()
    for pid_dir in glob.glob("/proc/[0-9]*"):
        try:
            if os.stat(pid_dir).st_uid != uid:
                continue
            with open(os.path.join(pid_dir, "comm"), "rb") as f:
                comm = f.read().decode("utf-8", errors="ignore").strip()
            if comm != "micro":
                continue
            with open(os.path.join(pid_dir, "cmdline"), "rb") as f:
                parts = [p.decode("utf-8", errors="ignore") for p in f.read().split(b"\0") if p]
            cwd = os.readlink(os.path.join(pid_dir, "cwd"))
            results.append((cwd, parts[1:]))
        except Exception:
            continue
    return results


def get_shell_cwds() -> list[str]:
    """Collect active working directories of user's shells/processes."""
    cwds = []
    seen = set()
    try:
        c = os.getcwd()
        cwds.append(c)
        seen.add(c)
    except OSError:
        pass

    uid = os.getuid()
    for pid_dir in glob.glob("/proc/[0-9]*"):
        try:
            if os.stat(pid_dir).st_uid != uid:
                continue
            with open(os.path.join(pid_dir, "comm"), "rb") as f:
                comm = f.read().decode("utf-8", errors="ignore").strip()
            if comm in ("bash", "zsh", "fish", "micro", "cli"):
                cwd = os.readlink(os.path.join(pid_dir, "cwd"))
                if cwd not in seen and os.path.isdir(cwd):
                    seen.add(cwd)
                    cwds.append(cwd)
        except Exception:
            continue
    return cwds


def detect_micro_active_file(screen_text: str) -> tuple[str | None, str | None]:
    """If the dumped screen was a Micro editor pane, return its (filepath, line)."""
    lines = [l.rstrip() for l in screen_text.splitlines() if l.strip()]
    if not lines:
        return None, None

    tail = "\n".join(lines[-3:])
    has_status_marker = "Alt-g: bindings" in tail or "| ft:" in tail
    has_line_numbers = sum(1 for l in lines[:-1] if re.match(r"^\s*\d+\s", l)) >= 3

    if not has_status_marker and not has_line_numbers:
        return None, None

    micro_procs = get_micro_processes()
    for line in reversed(lines[-3:]):
        # Status line format: "<filename> [modified] (<line>,<col>) | ft:<type> ..."
        m = re.match(r"^(\S+?)(?:\s+\+)?\s+\((\d+),(\d+)\)\s+\|\s+ft:", line)
        if m:
            raw_name, line_num = m.group(1), m.group(2)
            path, _ = parse_target(raw_name, [cwd for cwd, _ in micro_procs] + get_shell_cwds())
            if path:
                return path, line_num
        # Handle narrow panes where the status line is truncated before " (line,col)"
        prefix = line.split()[0] if line.split() else ""
        if prefix and prefix != "Alt-g:" and len(prefix) >= 4:
            for cwd, args in micro_procs:
                for arg in args:
                    if arg.startswith("+") or arg.startswith("-"):
                        continue
                    cleaned = arg[len("file://") :] if arg.startswith("file://") else arg
                    full = os.path.abspath(
                        os.path.expanduser(cleaned)
                        if os.path.isabs(cleaned) or cleaned.startswith("~")
                        else os.path.join(cwd, cleaned)
                    )
                    if (cleaned.startswith(prefix) or full.startswith(prefix)) and os.path.isfile(full):
                        return full, None
    return None, None


def get_recent_jetski_file_links() -> dict[str, str]:
    """Map basename -> full path from the most recently active Jetski transcripts."""
    mapping: dict[str, str] = {}
    brain_dir = os.path.join(HOME, ".gemini", "jetski", "brain")
    if not os.path.isdir(brain_dir):
        return mapping

    transcripts = glob.glob(os.path.join(brain_dir, "*", ".system_generated", "logs", "transcript.jsonl"))
    transcripts.sort(key=lambda p: os.path.getmtime(p), reverse=True)

    uri_re = re.compile(r"file://(/[A-Za-z0-9_./\-+@%,#=~!\[\]]+)")
    for tpath in transcripts[:3]:
        try:
            size = os.path.getsize(tpath)
            with open(tpath, "rb") as f:
                if size > 250_000:
                    f.seek(size - 250_000)
                data = f.read().decode("utf-8", errors="ignore")
            for m in uri_re.finditer(data):
                raw_uri = "file://" + m.group(1)
                resolved, line = parse_target(raw_uri)
                if resolved:
                    base = os.path.basename(resolved)
                    val = f"{resolved}:{line}" if line else resolved
                    mapping[base] = val
        except Exception:
            continue
    return mapping


def is_probably_text_file(filepath: str) -> bool:
    """Return True if filepath appears to be a text/markdown file (not an ELF/binary)."""
    try:
        with open(filepath, "rb") as f:
            chunk = f.read(512)
        return b"\x00" not in chunk
    except Exception:
        return False


def extract_screen_candidates(screen_text: str, cwds: list[str]) -> list[tuple[str, str | None]]:
    """Extract existing file paths visible on the dumped terminal screen (bottom-up)."""
    if not screen_text:
        return []

    raw_lines = screen_text.splitlines()
    # Build an unwrapped version to catch paths wrapped across terminal columns
    unwrapped_chunks: list[str] = []
    buf = ""
    for line in raw_lines:
        stripped = line.strip()
        if not stripped:
            if buf:
                unwrapped_chunks.append(buf)
                buf = ""
            continue
        # Remove leading bullet/indent continuation when joining wrapped path lines
        if buf and re.search(r"[/._\-A-Za-z0-9]$", buf) and re.match(r"^\s*[A-Za-z0-9_./\-+#]", line):
            buf += stripped
        else:
            if buf:
                unwrapped_chunks.append(buf)
            buf = stripped
    if buf:
        unwrapped_chunks.append(buf)

    search_lines = list(reversed(raw_lines)) + list(reversed(unwrapped_chunks))
    token_re = re.compile(
        r"(?:file:///[A-Za-z0-9_./\-+@%,#=~!:$L]+|"
        r"(?:~|/|\./|\.\./)[A-Za-z0-9_./\-+@%,#=~!:$L]+|"
        r"[A-Za-z0-9_.\-]+/[A-Za-z0-9_./\-+@%,#=~!:$L]+|"
        r"[A-Za-z0-9_.\-]+\.(?:md|markdown|rs|c|h|cc|cpp|py|go|sh|toml|json|yaml|yml|kdl|lua|txt)(?:#L\d+(?:-L?\d+)?|:\d+(?::\d+)?)?)",
        re.IGNORECASE,
    )

    jetski_links = get_recent_jetski_file_links()
    candidates: list[tuple[str, str | None]] = []
    seen: set[str] = set()

    for line in search_lines:
        matches = list(token_re.finditer(line))
        for m in reversed(matches):
            tok = m.group(0).rstrip(".,;)]}'\"")
            path, line_no = parse_target(tok, cwds)
            if not path:
                # Check if token is a basename rendered as an OSC 8 link in Jetski CLI
                base_tok = re.sub(r"(#L\d+.*|:\d+.*)$", "", tok)
                if base_tok in jetski_links:
                    path, j_line = parse_target(jetski_links[base_tok], cwds)
                    if not line_no:
                        line_no = j_line
            if path and path not in seen and is_probably_text_file(path):
                seen.add(path)
                candidates.append((path, line_no))

    return candidates


def open_in_viewer(filepath: str, line: str | None) -> None:
    """Exec leaf (for .md/.markdown) or micro (for everything else)."""
    lower = filepath.lower()
    # Zellij EditScrollback creates temporary files in /tmp; always open those in micro
    is_markdown = (lower.endswith(".md") or lower.endswith(".markdown")) and os.path.isfile(LEAF_BIN)

    if is_markdown:
        os.execvp(LEAF_BIN, [LEAF_BIN, "--watch", filepath])
    else:
        cmd = [MICRO_BIN]
        if line:
            cmd.append(f"+{line}")
        cmd.append(filepath)
        os.execvp(MICRO_BIN, cmd)


def pick_with_fzf(items: list[tuple[str, str | None, str]]) -> tuple[str | None, str | None]:
    """Present an fzf selector inside the floating pane when multiple links are on screen."""
    lines = []
    lookup: dict[str, tuple[str, str | None]] = {}
    for path, line_no, source_tag in items:
        short = path.replace(HOME, "~", 1) if path.startswith(HOME) else path
        loc = f":{line_no}" if line_no else ""
        kind = "📖 leaf " if path.lower().endswith((".md", ".markdown")) else "✏️ micro"
        display = f"{kind} │ {source_tag} │ {short}{loc}"
        if display not in lookup:
            lookup[display] = (path, line_no)
            lines.append(display)

    if not lines:
        return None, None
    if len(lines) == 1:
        return lookup[lines[0]]

    try:
        proc = subprocess.run(
            [
                "fzf",
                "--height=100%",
                "--layout=reverse",
                "--border=rounded",
                "--prompt=Open Link (leaf / micro) > ",
                "--header=[Enter] Open | [Esc] Cancel",
            ],
            input="\n".join(lines),
            text=True,
            stdout=subprocess.PIPE,
        )
        choice = proc.stdout.strip()
        if choice and choice in lookup:
            return lookup[choice]
    except Exception:
        return lookup[lines[0]]
    return None, None


def main() -> None:
    args = sys.argv[1:]

    # Mode 1: Direct invocation (e.g. from Zellij scrollback_editor / zellij:link Alt+Click)
    if args and args[0] != "--from-keybind":
        line = None
        target_arg = None
        for a in args:
            if a.startswith("+") and a[1:].isdigit():
                line = a[1:]
            else:
                target_arg = a
        if not target_arg:
            sys.exit(0)
        resolved, parsed_line = parse_target(target_arg, get_shell_cwds())
        final_path = resolved or os.path.expanduser(
            target_arg[len("file://") :] if target_arg.startswith("file://") else target_arg
        )
        open_in_viewer(final_path, line or parsed_line)
        return

    # Mode 2: Triggered from Zellij keybind (Alt/Cmd + Shift + M)
    screen_text = ""
    if os.path.isfile(SCREEN_DUMP_PATH):
        try:
            with open(SCREEN_DUMP_PATH, "r", encoding="utf-8", errors="ignore") as f:
                screen_text = f.read()
        except Exception:
            pass

    # 1. If the user pressed the shortcut while inside Micro, open that buffer directly
    micro_file, micro_line = detect_micro_active_file(screen_text)
    if micro_file:
        open_in_viewer(micro_file, micro_line)
        return

    cwds = get_shell_cwds()

    # 2. Check clipboard via OSC 52
    clip_raw = read_osc52_clipboard()
    clip_path, clip_line = parse_target(clip_raw, cwds)

    # 3. Extract links displayed on the active terminal pane
    screen_candidates = extract_screen_candidates(screen_text, cwds)

    # If clipboard holds a valid file and either:
    # - it was copied as a file:// link, OR
    # - its basename/path appears on the current screen, OR
    # - there are no other candidates on screen,
    # open it immediately without prompting!
    if clip_path:
        clip_base = os.path.basename(clip_path)
        if (
            clip_raw.strip().startswith("file://")
            or not screen_candidates
            or any(p == clip_path for p, _ in screen_candidates)
            or (screen_text and clip_base in screen_text)
        ):
            open_in_viewer(clip_path, clip_line)
            return

    # If there is exactly 1 file link visible on screen (and no conflicting clipboard file), open immediately!
    if len(screen_candidates) == 1 and not clip_path:
        open_in_viewer(screen_candidates[0][0], screen_candidates[0][1])
        return

    # Otherwise build list for quick selection (clipboard first, then screen links bottom-up)
    items: list[tuple[str, str | None, str]] = []
    if clip_path:
        items.append((clip_path, clip_line, "📋 clipboard"))
    for p, l in screen_candidates:
        if p != clip_path:
            items.append((p, l, "🖥️  screen   "))

    if not items:
        # Fallback: include recent Jetski conversation artifact/file links
        for _, target in list(get_recent_jetski_file_links().items())[:15]:
            p, l = parse_target(target, cwds)
            if p:
                items.append((p, l, "🕒 recent   "))

    chosen_path, chosen_line = pick_with_fzf(items)
    if chosen_path:
        open_in_viewer(chosen_path, chosen_line)


if __name__ == "__main__":
    main()
