color-link preproc "#e9a448,"
color-link type "#416978,"
color-link special "#e9a448,"
color-link underlined "underline #958b83,"
color-link error "#d4ccb9,#bd100d"
color-link todo "bold #20111a,#e9a448"

color-link statusline "#958b83,#2a1620"
color-link tabbar "#958b83,#2a1620"
color-link indent-char "#45363b,"
color-link line-number "#5e5252,#170c12"
color-link current-line-number "#958b83,#170c12"
color-link gutter-error "#bd100d,"
color-link gutter-warning "#e9a448,"
