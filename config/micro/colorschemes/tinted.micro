color-link default "#958b83,#170c12"

color-link comment "#5e5252,"
color-link identifier "#98999c,"
color-link constant "#96522b,"
color-link constant.string "#858062,"
color-link constant.string.char "#858062,"
color-link constant.number "#96522b,"
color-link symbol "#e9a448,"
